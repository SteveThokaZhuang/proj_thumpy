# ============================================================
# 凭据 —— 绝不入库
# ============================================================
# env.sh 第 31 行是明文 Hugging Face token。
# 模板见 pilot_study/env.sh.example, 复制成 env.sh 后自行填 token。
env.sh
*.env
.env
**/secrets.*
*.token

# ============================================================
# 数据与产物 —— 体量太大, 见 README「数据从哪来」
# ============================================================
# CANDOR 评测产物 / 观测空间 npz / 日志: 合计 ~146 G
pilot_study/real_data/
pilot_study/ari_logs/
pilot_study/g1_logs/
*.log

# 中间缓存 (parquet 等)
temp/

# 音频 / 观测空间 / 模型权重 (都能由脚本重生成)
*.npz
*.npy
*.mp3
*.wav
*.flac
*.pt
*.pth
*.bin
*.safetensors
*.ckpt

# ============================================================
# 第三方仓库 —— 按 README 里的 URL 与 commit 自行 clone
# ============================================================
third_party/

# ============================================================
# 第三方论文原文 —— 版权内容, 不入库
# ============================================================
# pilot_study/refs/ 里是别人论文的 PDF 与提取文本 (如 DuplexGen,
# arXiv 2607.26178v2)。这是**版权内容**, 推到公开仓库不合适; 而且它是
# 可再取得的 —— 按 arXiv 编号自己下一份即可 (出处记在
# docs/pilot_study/2026-09-23_duplexgen_humdial_recon.md 的参考文献里)。
# 教训: 结论引用的**行号**要对着某个确定的版本, 所以版本号必须写进文档,
# 不能只写「某篇论文」。
pilot_study/refs/

# ============================================================
# Python / 编辑器 / 系统
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.vscode/
.idea/
.claude/settings.local.json
.DS_Store
*.swp
