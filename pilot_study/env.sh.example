#!/usr/bin/env bash
# env.sh 的脱敏模板。用法:
#     cp env.sh.example env.sh   # 然后填入自己的 token
#     source env.sh
#
# ⚠️ env.sh 已被 .gitignore 排除 —— 那是故意的, 里面是明文凭据。
#    不要把它加进仓库 (git add -f 也不行)。
#
# 为什么需要这个文件:
#   conda run / conda activate 默认不设置 LD_LIBRARY_PATH,
#   导致 python 扩展模块 (如 _sqlite3) 的依赖解析到系统 /lib64 的旧版 libstdc++
#   (RHEL8, 最高 CXXABI_1.3.11), 而 pyannote 4.x 依赖链中的 ICU 库需要 CXXABI_1.3.15,
#   表现为: ImportError: version `CXXABI_1.3.15' not found (required by .../libicui18n.so.78)

# 优先使用当前激活的 conda 环境; 未激活或激活的是 base 时回退到 fd_pilot
CONDA_PREFIX_ENV="${CONDA_PREFIX:-}"
if [ -z "$CONDA_PREFIX_ENV" ] || [ "$(basename "$CONDA_PREFIX_ENV")" = "miniconda3" ]; then
    CONDA_PREFIX_ENV="$HOME/miniconda3/envs/fd_pilot"
fi
if [ ! -d "$CONDA_PREFIX_ENV/lib" ]; then
    echo "⚠️  未找到环境: $CONDA_PREFIX_ENV, 请先: conda activate fd_pilot" >&2
    return 1 2>/dev/null || exit 1
fi

export LD_LIBRARY_PATH="$CONDA_PREFIX_ENV/lib:$LD_LIBRARY_PATH"
echo "✓ LD_LIBRARY_PATH 已设置: $LD_LIBRARY_PATH"

# 运行 pipeline 需要 Hugging Face token (gated 模型访问):
#   1. 访问 https://huggingface.co/pyannote/speaker-diarization-3.1 并接受协议
#   2. 访问 https://huggingface.co/pyannote/segmentation-3.0 并接受协议
#   3. 在 https://huggingface.co/settings/tokens 创建 Read token
#   4. 把 token 填到下面 (或改从环境里读, 别写死在文件里)
export HF_TOKEN="${HF_TOKEN:-hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx}"

# 国内网络走 hf-mirror 加速; 注意 gated 仓库若 403, 需覆盖回官方站:
#   export HF_ENDPOINT=https://huggingface.co
export HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"
